# Dependencies
node_modules/

# Runtime artifacts — the SQLite database and WAL files
cineva.db
cineva.db-*

# Local binaries and logs
/bin/
/server/cineva
*.log

# Downloaded artwork cache
artwork/

# Note: server/ui/*/dist IS committed for now so a fresh clone can
# `go build` (go:embed needs the built assets). Revisit once CI builds them.

# Real local config (may hold secrets like the TMDB key) — the committed
# reference is server/cineva.example.yaml. Viper searches the working
# directory, so the file lands wherever the binary is run from: ignore both
# the repo root and server/ so a key cannot be committed by accident.
cineva.yaml
server/cineva.yaml
.env
# Local build settings (TMDB_KEY and the like), pulled in by the Makefile.
local.mk
